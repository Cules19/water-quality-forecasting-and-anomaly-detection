{
  "name": "common1000_rainfall_ablation_v1",
  "merged_input_root": "analysis_outputs/ph_common1000_teacher_archive_features_v1/full/hourly_ph_rainfall_by_site",
  "primary_cohort_path": "analysis_outputs/ph_common1000_teacher_archive_features_v1/full/reports/primary_archive_experiment_cohort.csv",
  "preparation_config": "config/common1000_leave_sites_out_v1.json",
