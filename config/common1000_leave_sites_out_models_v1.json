{
  "name": "common1000_leave_sites_out_models_v1",
  "prepared_root": "analysis_outputs/ph_common1000_leave_sites_out_v1",
  "preparation_config": "config/common1000_leave_sites_out_v1.json",
  "metadata_input": "analysis_outputs/ph_common1000_hgb_v1/full/reports/metadata_model_ready.csv",
  "flow_metadata_input": "analysis_outputs/ph_common1000_site_analysis_v1/reports/site_flow_metrics.csv",
  "output_root": "analysis_outputs/ph_common1000_leave_sites_out_models_v1",
  "random_seed": 42,
  "hidden_size": 64,
  "film_hidden_size": 64,
  "head_hidden_size": 32,
  "dropout": 0.1,
  "learning_rate": 0.001,
  "weight_decay": 0.00001,
  "early_stopping_patience": 2,
  "target_history_fill_limit_hours": 6,
  "smoke": {
    "maximum_epochs": 2,
    "train_window_cap_per_site": 400,
    "validation_window_cap_per_site": 200,
    "train_batch_size": 4096,
    "prediction_batch_size": 8192
  },
  "full": {
    "maximum_epochs": 6,
    "train_window_cap_per_site": 2500,
    "validation_window_cap_per_site": 500,
    "train_batch_size": 8192,
    "prediction_batch_size": 16384
  },
  "metadata_fields": [
    "meta_latitude",
    "meta_longitude",
    "meta_elevation",
    "meta_drainage_area_km2",
    "meta_average_precip_mm_yr",
    "meta_average_evapo_trans_mm_yr",
    "meta_population_est_2020",
    "meta_watershed_dams_no",
    "meta_watershed_dams_cap_m3",
    "meta_irrigation_area_km2",
    "meta_irrigation_area_pct",
    "meta_dominant_land_cover_pct",
    "log10_mean_flow",
    "flow_cv",
    "richards_baker_flashiness",
    "q95_q50_ratio"
  ],
  "metadata_log1p_fields": [
    "meta_drainage_area_km2",
    "meta_population_est_2020",
    "meta_watershed_dams_no",
    "meta_watershed_dams_cap_m3",
    "meta_irrigation_area_km2"
  ],
  "coordinate_fields": ["meta_latitude", "meta_longitude"],
  "models": [
    {
      "model_id": "GRU_EXOG_NO_META",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "gru",
      "recurrent_layers": 1,
      "conditioning": "none",
      "metadata_variant": "none",
      "target_history": false,
      "train_non_event": false
    },
    {
      "model_id": "GRU_EXOG_FILM_NO_COORD",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "gru",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "no_coordinates",
      "target_history": false,
      "train_non_event": false
    },
    {
      "model_id": "LSTM_EXOG_FILM_NO_COORD",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "lstm",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "no_coordinates",
      "target_history": false,
      "train_non_event": false
    },
    {
      "model_id": "GRU_EXOG_FILM_WITH_COORD",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "gru",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "with_coordinates",
      "target_history": false,
      "train_non_event": false
    },
    {
      "model_id": "GRU_HISTORY_FILM_NO_COORD",
      "targets": ["ph", "do"],
      "horizons": [1, 3, 6, 12, 24, 48],
      "recurrent_type": "gru",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "no_coordinates",
      "target_history": true,
      "train_non_event": false
    },
    {
      "model_id": "LSTM_HISTORY_FILM_NO_COORD",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "lstm",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "no_coordinates",
      "target_history": true,
      "train_non_event": false
    },
    {
      "model_id": "GRU_HISTORY_FILM_NO_COORD_NONEVENT",
      "targets": ["ph", "do"],
      "horizons": [1],
      "recurrent_type": "gru",
      "recurrent_layers": 1,
      "conditioning": "film",
      "metadata_variant": "no_coordinates",
      "target_history": true,
      "train_non_event": true
    }
  ],
  "forbidden_predictors": [
    "site_id",
    "site_embedding",
    "in_event",
    "event_label",
    "event_direction",
    "event_id",
    "future_target",
    "residual",
    "prediction"
  ]
}
